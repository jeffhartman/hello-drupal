{
    "name": "drupal/hello-antarctica",
    "description": "A conceptual polar travel company backend built with Drupal.",
    "type": "project",
    "license": "proprietary",
    "homepage": "https://hello-antarctica.com",
    "support": {},
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^2.0",
        "drupal/address": "^2.0",
        "drupal/admin_toolbar": "^3.6",
        "drupal/better_exposed_filters": "^7.1",
        "drupal/color_field": "^3.0",
        "drupal/commerce": "^3.3",
        "drupal/config_ignore": "^3.4",
        "drupal/config_split": "^2.0",
        "drupal/core-composer-scaffold": "^11.4",
        "drupal/core-project-message": "^11.4",
        "drupal/core-recipe-unpack": "^11.4",
        "drupal/core-recommended": "^11.4",
        "drupal/crop": "^2.6",
        "drupal/draggableviews": "^2.1",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/entity": "^1.7",
        "drupal/entity_browser": "^2.17",
        "drupal/field_group": "^4.0",
        "drupal/focal_point": "^2.1",
        "drupal/fpa": "^4.0",
        "drupal/geolocation": "^4.0",
        "drupal/gin": "^5.0",
        "drupal/gin_everywhere": "^1.5",
        "drupal/gin_login": "^2.1",
        "drupal/google_tag": "^2.0",
        "drupal/imageapi_optimize": "^4.2",
        "drupal/imageapi_optimize_gd": "^2.0",
        "drupal/imageapi_optimize_webp": "^3.0@beta",
        "drupal/inline_entity_form": "^3.0",
        "drupal/menu_block": "^1.14",
        "drupal/menu_item_extras": "^3.1",
        "drupal/metatag": "^2.2",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_tools": "^6.1",
        "drupal/module_filter": "^5.0",
        "drupal/paragraphs": "^1.23",
        "drupal/pathauto": "^1.15",
        "drupal/rabbit_hole": "^1.2",
        "drupal/range": "^1.6",
        "drupal/redirect": "^1.13",
        "drupal/restui": "^1.22",
        "drupal/robotstxt": "^1.6",
        "drupal/scheduler": "^2.3",
        "drupal/search_api": "^1.41",
        "drupal/search_api_algolia": "^3.1",
        "drupal/simple_sitemap": "^4.2",
        "drupal/smart_date": "^4.3",
        "drupal/taxonomy_manager": "^2.0",
        "drupal/token": "^1.17",
        "drupal/token_filter": "^2.2",
        "drupal/twig_tweak": "^3.4",
        "drupal/views_bulk_operations": "^4.4",
        "drupal/views_field_view": "^1.0",
        "drupal/viewsreference": "^2.0@beta",
        "drupal/webform": "^6.3",
        "drupal/yearonly": "^9.1",
        "drush/drush": "^13.7"
    },
    "require-dev": {
        "acquia/coding-standards": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "drupal/core-dev": "^11.4",
        "mglaman/phpstan-drupal": "^2.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-recipe-unpack": true,
            "php-http/discovery": true,
            "php-tuf/composer-integration": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "docroot/"
            },
            "file-mapping": {
                "[web-root]/modules/README.txt": { "mode": "skip" },
                "[web-root]/profiles/README.txt": { "mode": "skip" },
                "[web-root]/themes/README.txt": { "mode": "skip" },
                "[web-root]/sites/README.txt": { "mode": "skip" },
                "[web-root]/INSTALL.txt": { "mode": "skip" },
                "[project-root]/recipes/README.txt": { "mode": "skip" }
            }
        },
        "installer-paths": {
            "docroot/core": ["type:drupal-core"],
            "docroot/libraries/{$name}": ["type:drupal-library"],
            "docroot/modules/contrib/{$name}": ["type:drupal-module"],
            "docroot/profiles/contrib/{$name}": ["type:drupal-profile"],
            "docroot/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/contrib/{$name}": ["type:drupal-drush"],
            "docroot/modules/custom/{$name}": ["type:drupal-custom-module"],
            "docroot/profiles/custom/{$name}": ["type:drupal-custom-profile"],
            "docroot/themes/custom/{$name}": ["type:drupal-custom-theme"],
            "recipes/{$name}": ["type:drupal-recipe"]
        },
        "patches": {
            "drupal/draggableviews": {
                "Fix RouteNotFoundException for view.this contextual link": "https://www.drupal.org/files/issues/2024-06-10/3316975-32-MR40.patch",
                "PHP 8.4 nullable migration parameters": "https://git.drupalcode.org/project/draggableviews/-/commit/d28d6be55b19bf221ae7c1dfff13457721ef5ae5.patch"
            },
            "drupal/rabbit_hole": {
                "PHP 8.4 nullable parameters": "https://www.drupal.org/files/issues/2026-07-28/php84-nullable-params.patch"
            },
            "drupal/views_field_view": {
                "Fix Drupal 11.4 views_ui_build_form_url error": "https://www.drupal.org/files/issues/2026-07-14/views_field_view-11.4-deprecated-function.patch"
            }
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ]
        },
        "phpcodesniffer-search-depth": "4"
    }
}
